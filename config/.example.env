# =========================
# ===== ENVIRONMENT ======
# =========================

# test | test2 | prod
ENV=test


# =========================
# ===== APPIUM ===========
# =========================

APPIUM_URL=http://127.0.0.1:4723
DEVICE_NAME=Android
UDID=emulator-5554
APP_PACKAGE=com.naruzhu.vpn
APP_ACTIVITY=.MainActivity
APPIUM_NO_RESET=true
APPIUM_IMPLICIT_WAIT=0
APPIUM_EXPLICIT_WAIT=15


# =========================
# ===== API ===============
# =========================

# Base URLs for different environments
API_BASE_URL=https://naruzhu-client-api.vpnn.space
API_BASE_URL_TEST=https://api.new.vpn-naruzhu.com
API_BASE_URL_TEST_2=https://api.new2.vpn-naruzhu.com

# Headers
USER_AGENT=naruzhu-android/1.6.1
SUPPORTED_AWG_VERSION=1.5
DEVICE_ID=test-device-id


# =========================
# ===== WEB ===============
# =========================

# Пусто -> web-тесты пропускаются
WEB_BASE_URL=
# chrome | firefox
WEB_BROWSER=chrome
WEB_HEADLESS=false
WEB_EXPLICIT_WAIT=10


# =========================
# ===== TEST DATA =========
# =========================

# Данные тестового аккаунта (email, OTP, public_request_id, ...) —
# в testdata/test_data.local.json (шаблон: testdata/test_data.json).
# Статичные данные API-тестов — в testdata/api_data.py.


# =========================
# ===== DATABASE (SSH) ====
# =========================

# SSH Tunnel settings
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=C:/path/to/private/key

# PostgreSQL settings
DB_HOST=
DB_PORT=5432
# База выбирается по ENV: test -> DB_NAME_TEST, test2 -> DB_NAME_TEST_2, prod -> DB_NAME
DB_NAME=
DB_NAME_TEST=naruzhu_test
DB_NAME_TEST_2=naruzhu_test2
DB_USER=
DB_PASSWORD=


# =========================
# ===== OPTIONAL ==========
# =========================

# Logging / debug flags
DEBUG=false

# Timeout for API requests (seconds)
API_TIMEOUT=30