# =========================
# ===== ENVIRONMENT ======
# =========================

# test | test2 | prod
ENV=test


# =========================
# ===== APPIUM ===========
# =========================

APPIUM_URL=http://127.0.0.1:4723
DEVICE_NAME=Android
UDID=emulator-5554
APP_PACKAGE=com.naruzhu.vpn
APP_ACTIVITY=.MainActivity


# =========================
# ===== API ===============
# =========================

# Base URLs for different environments
API_BASE_URL=https://naruzhu-client-api.vpnn.space
API_BASE_URL_TEST=https://naruzhu-client-api.test.vpnn.space
API_BASE_URL_TEST_2=https://naruzhu-client-api2.test.vpnn.space

# Headers
USER_AGENT=naruzhu-android/1.6.1
SUPPORTED_AWG_VERSION=1.5
DEVICE_ID=test-device-id


# =========================
# ===== TEST DATA =========
# =========================

TEST_EMAIL=
TEST_OTP=


# =========================
# ===== DATABASE (SSH) ====
# =========================

# SSH Tunnel settings
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=C:/path/to/private/key

# PostgreSQL settings
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=


# =========================
# ===== OPTIONAL ==========
# =========================

# Logging / debug flags
DEBUG=false

# Timeout for API requests (seconds)
API_TIMEOUT=30